@model IEnumerable<EventEase_WebApp.Models.BookingDetail>
@{
    ViewData["Title"] = "Bookings";
    var searchTerm = ViewBag.SearchTerm as string;
    var fromDate = ViewBag.FromDate as DateTime?;
    var toDate = ViewBag.ToDate as DateTime?;
    var venueAvailability = ViewBag.VenueAvailability as string ?? "all";
    var eventTypes = ViewBag.EventTypes as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var hasFilters = (ViewBag.HasFilters as bool?) ?? false;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Bookings</h1>
    <a class="btn btn-primary" asp-action="Create">Capture booking</a>
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label for="searchTerm" class="form-label small text-muted mb-1">Search</label>
        <input type="text"
               id="searchTerm"
               name="searchTerm"
               value="@searchTerm"
               class="form-control"
               placeholder="Search by booking reference (GUID) or event name" />
    </div>

    <div class="col-md-2">
        <label for="eventTypeId" class="form-label small text-muted mb-1">Event type</label>
        <select id="eventTypeId" name="eventTypeId" class="form-select" asp-items="eventTypes">
            <option value="">All event types</option>
        </select>
    </div>

    <div class="col-md-2">
        <label for="fromDate" class="form-label small text-muted mb-1">From date</label>
        <input type="date"
               id="fromDate"
               name="fromDate"
               value="@(fromDate?.ToString("yyyy-MM-dd"))"
               class="form-control"
               title="From booking date" />
    </div>

    <div class="col-md-2">
        <label for="toDate" class="form-label small text-muted mb-1">To date</label>
        <input type="date"
               id="toDate"
               name="toDate"
               value="@(toDate?.ToString("yyyy-MM-dd"))"
               class="form-control"
               title="To booking date" />
    </div>

    <div class="col-md-2">
        <label for="venueAvailability" class="form-label small text-muted mb-1">Venue status</label>
        <select id="venueAvailability" name="venueAvailability" class="form-select">
            @if (venueAvailability == "all")
            {
                <option value="all" selected>All venues</option>
            }
            else
            {
                <option value="all">All venues</option>
            }

            @if (venueAvailability == "available")
            {
                <option value="available" selected>Available only</option>
            }
            else
            {
                <option value="available">Available only</option>
            }

            @if (venueAvailability == "unavailable")
            {
                <option value="unavailable" selected>Unavailable only</option>
            }
            else
            {
                <option value="unavailable">Unavailable only</option>
            }
        </select>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Apply filters</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @if (hasFilters)
        {
            <span>No bookings found for the selected filters.</span>
        }
        else
        {
            <span>No bookings yet.</span>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Event</th>
                    <th>Event Type</th>
                    <th>Event Date</th>
                    <th>Venue</th>
                    <th>Venue Availability</th>
                    <th>Location</th>
                    <th>Reference</th>
                    <th class="actions-col actions-col-compact"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="text-nowrap">@b.BookingDate.ToString("yyyy-MM-dd")</td>
                        <td class="fw-semibold">@b.EventName</td>
                        <td>@b.EventTypeName</td>
                        <td class="text-nowrap">@b.EventDate.ToString("yyyy-MM-dd")</td>
                        <td>@b.VenueName</td>
                        <td>@(b.VenueIsAvailable ? "Available" : "Unavailable")</td>
                        <td>@b.VenueLocation</td>
                        <td><code>@b.BookingId</code></td>
                        <td class="text-end">
                            <div class="table-actions table-actions-compact">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@b.BookingId">Details</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.BookingId">Edit</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@b.BookingId">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}