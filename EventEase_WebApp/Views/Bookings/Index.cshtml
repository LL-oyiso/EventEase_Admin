@model IEnumerable<EventEase_WebApp.Models.Booking>
@{
    ViewData["Title"] = "Bookings";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Bookings</h1>
    <a class="btn btn-primary" asp-action="Create">Capture booking</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No bookings yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Venue</th>
                    <th>Event</th>
                    <th>Reference</th>
                    <th style="width: 240px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="text-nowrap">@b.BookingDate.ToString("yyyy-MM-dd")</td>
                        <td class="fw-semibold">@b.Venue?.VenueName</td>
                        <td>@b.Event?.EventName</td>
                        <td><code>@b.BookingId</code></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@b.BookingId">Details</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.BookingId">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@b.BookingId">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}