@model EventEase_WebApp.Models.Booking
@{
    ViewData["Title"] = "Capture Booking";
}

<h1 class="h3 mb-3">Capture booking</h1>

<div class="alert alert-info">Rule: a venue cannot be booked twice for the same date.</div>

<form asp-action="Create" method="post" class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="EventId" class="form-label">Event</label>
            <select asp-for="EventId" class="form-select" asp-items="ViewBag.EventId">
                <option value="">-- Select event --</option>
            </select>
            <span asp-validation-for="EventId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="VenueId" class="form-label">Venue</label>
            <select asp-for="VenueId" class="form-select" asp-items="ViewBag.VenueId">
                <option value="">-- Select venue --</option>
            </select>
            <span asp-validation-for="VenueId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BookingDate" class="form-label">Booking date</label>
            <input asp-for="BookingDate" class="form-control" type="date" />
            <span asp-validation-for="BookingDate" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Capture</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </div>
</form>