@model EventEase_WebApp.Models.Booking
@{
    ViewData["Title"] = "Booking Details";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Booking details</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.BookingId">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Reference</dt>
            <dd class="col-sm-9"><code>@Model.BookingId</code></dd>

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.BookingDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Venue</dt>
            <dd class="col-sm-9">@Model.Venue?.VenueName</dd>

            <dt class="col-sm-3">Event</dt>
            <dd class="col-sm-9">@Model.Event?.EventName</dd>
        </dl>
    </div>
</div>
