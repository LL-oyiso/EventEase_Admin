@model EventEase_WebApp.Models.Venue
@{
    ViewData["Title"] = "Venue Details";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">@Model.VenueName</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.VenueId">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="mb-3">
            <img src="@Model.ImageUrl" alt="@Model.VenueName image" class="img-fluid rounded border" style="max-height: 280px; object-fit: cover;" />
        </div>
        <dl class="row mb-0">
            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Model.Location</dd>

            <dt class="col-sm-3">Capacity</dt>
            <dd class="col-sm-9">@Model.Capacity</dd>

            <dt class="col-sm-3">Availability</dt>
            <dd class="col-sm-9">@(Model.IsAvailable ? "Available" : "Unavailable")</dd>

            <dt class="col-sm-3">Image URL</dt>
            <dd class="col-sm-9"><small class="text-muted">@Model.ImageUrl</small></dd>
        </dl>
    </div>
</div>
