@model IEnumerable<EventEase_WebApp.Models.Venue>
@{
    ViewData["Title"] = "Venues";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Venues</h1>
    <a class="btn btn-primary" asp-action="Create">Create venue</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No venues yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Location</th>
                    <th class="text-end">Capacity</th>
                    <th style="width: 240px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td class="fw-semibold">@v.VenueName</td>
                        <td>@v.Location</td>
                        <td class="text-end">@v.Capacity</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@v.VenueId">Details</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@v.VenueId">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@v.VenueId">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}