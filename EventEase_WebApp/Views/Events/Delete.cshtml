@model EventEase_WebApp.Models.Event
@{
    ViewData["Title"] = "Delete Event";
    var hasBookings = (ViewBag.HasBookings as bool?) ?? false;
}

<h1 class="h3 mb-3">Delete event</h1>

<div class="card">
    <div class="card-body">
        @if (TempData["Error"] is string error && !string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        @if (hasBookings)
        {
            <div class="alert alert-warning">
                This event cannot be deleted because it is linked to one or more bookings.
            </div>
        }
        else
        {
            <div class="alert alert-danger">
                This action cannot be undone.
            </div>
        }

        <dl class="row">
            <dt class="col-sm-3">Image</dt>
            <dd class="col-sm-9">
                <img src="@Model.ImageUrl" alt="@Model.EventName image" class="img-thumbnail" style="max-height: 180px;" />
            </dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.EventName</dd>

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.EventDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Event Type</dt>
            <dd class="col-sm-9">@(Model.EventType?.EventTypeName ?? "Unclassified")</dd>

            <dt class="col-sm-3">Venue</dt>
            <dd class="col-sm-9">@(Model.Venue?.VenueName ?? "Unassigned")</dd>
        </dl>

        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input type="hidden" asp-for="EventId" />
            <button type="submit" class="btn btn-danger" @(hasBookings ? "disabled" : "")>Delete</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
