@model IEnumerable<EventEase_WebApp.Models.Event>
@{
    ViewData["Title"] = "Events";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Events</h1>
    <a class="btn btn-primary" asp-action="Create">Create event</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No events yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Date</th>
                    <th>Name</th>
                    <th>Event Type</th>
                    <th>Venue</th>
                    <th style="width: 240px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><img src="@e.ImageUrl" alt="@e.EventName image" class="rounded border" style="width: 72px; height: 48px; object-fit: cover;" /></td>
                        <td class="text-nowrap">@e.EventDate.ToString("yyyy-MM-dd")</td>
                        <td class="fw-semibold">@e.EventName</td>
                        <td>@(e.EventType?.EventTypeName ?? "Unclassified")</td>
                        <td>@(e.Venue?.VenueName ?? "Unassigned")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@e.EventId">Details</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.EventId">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@e.EventId">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}